#include <stdio.h>
#include <stdlib.h>

int *repeticao(int *vet, int tam, int *n);

int main() {
    int q, a;
    int *vetor;
    int n = 0;
    int *resposta;

    printf("Insira o tamanho do vetor: \n");
    scanf("%d", &q);

    vetor = (int *) malloc(q * sizeof(int));
    if (vetor == NULL) {
        printf("Falta memoria\n");
        return 1;
    }

    for (a = 0; a < q; a++) {
        printf("Insira o %d valor do vetor (de 0 ate 9): \n", a + 1);
        scanf("%d", &vetor[a]);
    }

    resposta = repeticao(vetor, q, &n);

    printf("\nSaida:\n");
    for (a = 0; a < n; a++) {
        if (a > 0) {
            printf(", ");
        }
        printf("%d", resposta[a]);
    }
    printf("\n");

    free(vetor);
    free(resposta);

    return 0;
}

int *repeticao(int *vet, int tam, int *n) {
    int a, b;
    int pos = 0;

    int *resp = (int *) malloc(tam * sizeof(int));
    if (resp == NULL) {
        printf("Falta memoria\n");
        return NULL;
    }

    for (a = 0; a < tam; a++) {

        int ja_analisado = 0;
        for (b = 0; b < a; b++) {
            if (vet[a] == vet[b]) {
                ja_analisado = 1;
                break;
            }
        }

        if (!ja_analisado) {
            int se_repete = 0;
            for (b = a + 1; b < tam; b++) {
                if (vet[a] == vet[b]) {
                    se_repete = 1;
                    break;
                }
            }

            if (se_repete) {
                resp[pos] = vet[a];
                pos++;
            }
        }
    }

    *n = pos;

    return resp;
}