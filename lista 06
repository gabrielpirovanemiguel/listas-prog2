int main() {
    int q, a, b;
    int *vetor;

    printf("Insira o tamanho do vetor: \n");
    scanf("%d", &q);

    vetor = (int *) malloc(q * sizeof(int));
    if (vetor == NULL) {
        printf("Falta memoria\n");

    }

    for (a = 0; a < q; a++) {
        printf("Insira o %d valor do vetor (de 0 ate 9): \n", a + 1);
        scanf("%d", &vetor[a]);
    }

    printf("\nValores que se repetem: ");
    int primeiro = 1;

    for (a = 0; a < q; a++) {

        int ja_analisado = 0;
        for (b = 0; b < a; b++) {
            if (vetor[a] == vetor[b]) {
                ja_analisado = 1;
                break;
            }
        }


        if (!ja_analisado) {
            int se_repete = 0;

            for (b = a + 1; b < q; b++) {
                if (vetor[a] == vetor[b]) {
                    se_repete = 1;
                    break;
                }
            }


            if (se_repete) {
                if (!primeiro) {
                    printf(", ");
                }
                printf("%d", vetor[a]);
                primeiro = 0;
            }
        }
    }

    printf("\n");

    free(vetor);
}

