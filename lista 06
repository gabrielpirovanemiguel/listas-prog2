float *acima_da_media(int n, float *vet, int *tam){
    float soma =0, media;
    int i, cont =0;
    for(i=0; i<n; i++){
        soma +=vet[i];
    }
    media = soma/n;

    for(i=0; i<n; i++){
        if(vet[i]> media){
            cont++;
        }
    }
    *tam = cont;
    if(cont == 0){
            printf("Não há valores maior que a media %f", media);
            return NULL;
    }
    else{
        float *novoVetor = (float *) malloc(cont * sizeof(float));
        if (novoVetor == NULL) {return NULL;}
        int b=0;
        for(i=0; i<n; i++){
            if(vet[i]> media){
                novoVetor[b] = vet[i];
                b++;
            }
        }
        return novoVetor;

    }

}


